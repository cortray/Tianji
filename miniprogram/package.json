{
  "name": "tianji-miniprogram",
  "version": "0.1.0",
  "private": true,
  "description": "天机 AI 微信小程序（Taro + React + TypeScript）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "none",
    "framework": "React"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@nutui/nutui-react-taro": "^4.0.0-beta.5",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "clsx": "^2.1.1",
    "lunar-javascript": "^1.7.7",
    "marked": "^18.0.9",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@tarojs/cli": "4.2.1",
    "@tarojs/vite-runner": "4.2.1",
    "@types/node": "^18",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-preset-taro": "4.2.1",
    "bootstrap-icons": "^1.13.1",
    "postcss": "^8.5.6",
    "react-refresh": "^0.14.0",
    "terser": "^5.30.4",
    "typescript": "^5.4.5",
    "vite": "^4.2.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.3.96": true,
    "@tarojs/binding@4.2.1": true,
    "@tarojs/cli@4.2.1": true,
    "core-js@3.50.0": true,
    "core-js-pure@3.50.0": true,
    "esbuild@0.21.5": true,
    "esbuild@0.18.20": true,
    "@nutui/nutui-react-taro@4.0.0-beta.5": true

/* 天机 · 自定义底部导航（悬浮式） */
.tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 20rpx;
  z-index: 999;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 44rpx;
  box-shadow: 0 12rpx 40rpx rgba(30, 27, 75, 0.14);
  border: 2rpx solid rgba(255, 255, 255, 0.7);
}
.tabbar-inner {
  display: flex;
  padding: 14rpx 10rpx 10rpx;
}
.tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.tabbar-icon {
  width: 88rpx;
  height: 64rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s ease;
}
.tabbar-img {
  width: 52rpx;
  height: 52rpx;
}
.tabbar-icon-active {
  background: linear-gradient(135deg, #6d5ce7 0%, #8b7cf6 100%);
  box-shadow: 0 8rpx 20rpx rgba(109, 92, 231, 0.38);
}
.tabbar-text {
  font-size: 20rpx;
  color: #9aa3bd;
  transition: color 0.2s ease;
  line-height: 1.4;
}
.tabbar-text-active {
  color: #6d5ce7;
  font-weight: 600;
}
.tabbar-item-active .tabbar-text::after {
  content: '';
  display: block;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #e8b44a;
  margin: 4rpx auto 0;
}
.tabbar-safe {
  height: calc(env(safe-area-inset-bottom) + 10rpx);
}

/* 暗色 */
.tabbar.theme-dark {
  background: rgba(22, 29, 51, 0.96);
  border-color: rgba(42, 53, 82, 0.8);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.4);
}
.tabbar.theme-dark .tabbar-text {
  color: #67708c;
}
.tabbar.theme-dark .tabbar-text-active {
  color: #a5b4fc;
}

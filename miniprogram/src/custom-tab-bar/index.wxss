/* 天机 · 自定义底部导航（Animated Tab Bar 风格：深色胶囊 + 专属色高亮 + 平滑动画） */
.tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 20rpx;
  z-index: 999;
  background: rgba(255, 255, 255, 0.97);
  border-radius: 999rpx;
  box-shadow: 0 12rpx 44rpx rgba(30, 27, 75, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  display: flex;
  padding: 14rpx 10rpx;
}
.tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
}
.tabbar-icon {
  width: 92rpx;
  height: 76rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.45s cubic-bezier(0.4, 0, 0.2, 1),
    transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
    box-shadow 0.45s ease;
}
.tabbar-img {
  width: 44rpx;
  height: 44rpx;
  transition: transform 0.3s ease;
}
.tabbar-icon-active {
  background: var(--tabColor);
  transform: translateY(-8rpx);
  box-shadow: 0 10rpx 26rpx var(--tabColorSoft);
}
.tabbar-icon-active .tabbar-img {
  transform: scale(1.12);
}
.tabbar-text {
  font-size: 20rpx;
  color: #9aa3bd;
  transition: color 0.3s ease;
  line-height: 1.3;
}
.tabbar-text-active {
  color: var(--tabColor);
  font-weight: 600;
}
.tabbar-safe {
  height: calc(env(safe-area-inset-bottom) + 24rpx);
}

/* 暗色：深色胶囊（贴近原版 #1d1d27） */
.tabbar.theme-dark {
  background: rgba(23, 28, 45, 0.96);
  border-color: rgba(60, 68, 100, 0.5);
  box-shadow: 0 12rpx 44rpx rgba(0, 0, 0, 0.45);
}
.tabbar.theme-dark .tabbar-text {
  color: #67708c;
}
